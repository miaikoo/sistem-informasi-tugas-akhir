<UserControl x:Class="SITA.App.Views.BimbinganView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SITA.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:BimbinganViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <DockPanel Margin="20,16">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"
                            Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Catat Bimbingan"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource SearchBox}" Width="260" Tag="Cari mahasiswa atau topik..."
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Width="160" Margin="10,0,0,0" ItemsSource="{Binding StatusFilterOptions}"
                                  DisplayMemberPath="Label" SelectedItem="{Binding StatusFilter}"/>
                        <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} catatan'}" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" RowHeight="58">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TANGGAL" Binding="{Binding Tanggal, StringFormat='{}{0:dd MMM yyyy}'}" Width="115"
                                            ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Header="MAHASISWA" Width="1.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NamaMahasiswa}" FontWeight="SemiBold" Style="{StaticResource CellText}"/>
                                        <TextBlock Text="{Binding Nim}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="TOPIK &amp; CATATAN" Width="2.4*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Topik}" Style="{StaticResource CellText}"/>
                                        <TextBlock Text="{Binding Catatan}" Style="{StaticResource Muted}" FontSize="11.5"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Catatan}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="DICATAT OLEH" Binding="{Binding DosenNama}" Width="1.5*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Header="STATUS" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Style="{StaticResource Badge}" Tag="{Binding Status}" Content="{Binding StatusLabel}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Ubah" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        <Button Style="{StaticResource IconButtonDanger}" Content="&#xE74D;" ToolTip="Hapus" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" FontSize="36" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="Belum ada catatan bimbingan." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.ColumnSpan="2" Style="{StaticResource FormPanel}" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="22,18,14,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding CancelFormCommand}"/>
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" FontSize="16" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0">
                    <StackPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource FormError}" Visibility="{Binding FormError, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding FormError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" LineHeight="20"/>
                        </Border>
                        <TextBlock Text="Mahasiswa / Tugas Akhir *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding TaOptions}" DisplayMemberPath="Display" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedTaId}"/>
                        <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Dicatat oleh *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding PembimbingOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedDosenId}"/>
                        </StackPanel>
                        <TextBlock Text="Tanggal *" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding Editor.Tanggal}"/>
                        <TextBlock Text="Topik *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Editor.Topik, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"/>
                        <TextBlock Text="Catatan / Arahan" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource MultiLineTextBox}" Height="110" Text="{Binding Editor.Catatan, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Status *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Editor.Status}"/>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="Batal" Margin="0,0,10,0" Command="{Binding CancelFormCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Simpan" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
