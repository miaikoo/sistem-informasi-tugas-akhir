<UserControl x:Class="SITA.App.Views.PenggunaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SITA.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PenggunaViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <DockPanel Margin="20,16">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"
                            Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Tambah Pengguna"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource SearchBox}" Width="260" Tag="Cari username atau nama..."
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} akun'}" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="140" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="NAMA LENGKAP" Binding="{Binding NamaLengkap}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Header="PERAN" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Style="{StaticResource Badge}" Tag="{Binding Role}" Content="{Binding RoleLabel}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="DATA DOSEN TERTAUT" Binding="{Binding DosenNama, TargetNullValue='—'}" Width="2*" ElementStyle="{StaticResource CellText}"/>
                        <DataGridTemplateColumn Header="STATUS" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding StatusLabel}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Ubah" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        <Button Style="{StaticResource IconButtonDanger}" Content="&#xE74D;" ToolTip="Hapus" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.ColumnSpan="2" Style="{StaticResource FormPanel}" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="22,18,14,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding CancelFormCommand}"/>
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" FontSize="16" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0">
                    <StackPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource FormError}" Visibility="{Binding FormError, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding FormError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" LineHeight="20"/>
                        </Border>
                        <TextBlock Text="Username *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Editor.Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="30"/>
                        <TextBlock Text="Nama Lengkap *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Editor.NamaLengkap, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                        <TextBlock Text="Peran *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding RoleOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding FormRole}"/>
                        <StackPanel Visibility="{Binding IsDosenRole, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Tautkan ke Data Dosen *" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding DosenList}" DisplayMemberPath="Nama" SelectedValuePath="Id"
                                      SelectedValue="{Binding Editor.DosenId}"/>
                        </StackPanel>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                    <Setter Property="Text" Value="Reset Password"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                            <Setter Property="Text" Value="Password *"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged"/>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   Text="Minimal 6 karakter. Saat mengubah akun, kosongkan jika password tidak diganti."/>
                        <CheckBox Content="Akun aktif" IsChecked="{Binding Editor.IsActive}" Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="Batal" Margin="0,0,10,0" Command="{Binding CancelFormCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Simpan" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
