<Window x:Class="SITA.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SITA.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:LoginViewModel}"
        Title="SITA – Masuk" Width="920" Height="580" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Brand panel -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#312E81" Offset="0"/>
                    <GradientStop Color="#4F46E5" Offset="0.6"/>
                    <GradientStop Color="#7C3AED" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="44">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="44" Height="44" CornerRadius="12" Background="#33FFFFFF">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BE;" FontSize="22" Foreground="White"/>
                    </Border>
                    <TextBlock Text="SITA" FontSize="26" FontWeight="Bold" Foreground="White" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Sistem Informasi Tugas Akhir" FontSize="28" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,14,0,0" FontSize="14" Foreground="#D9DCFF" TextWrapping="Wrap" LineHeight="22"
                               Text="Pantau progres tugas akhir mahasiswa dari pengajuan judul, bimbingan, hingga sidang akhir dalam satu aplikasi."/>
                    <StackPanel Margin="0,28,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="#A5F3FC" FontSize="13"/>
                            <TextBlock Text="Dashboard progres real-time" Foreground="White" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="#A5F3FC" FontSize="13"/>
                            <TextBlock Text="Log bimbingan terdokumentasi" Foreground="White" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="#A5F3FC" FontSize="13"/>
                            <TextBlock Text="Penjadwalan sidang tanpa bentrok" Foreground="White" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="© 2026 Program Studi • PBKK" Foreground="#B4B8F0" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Login form -->
        <Grid Grid.Column="1">
            <StackPanel Width="340" VerticalAlignment="Center">
                <TextBlock Text="Selamat datang" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Masuk menggunakan akun yang diberikan program studi." Style="{StaticResource Muted}" Margin="0,6,0,20"/>

                <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged"/>

                <Border Style="{StaticResource FormError}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" FontSize="13" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" Margin="8,0,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource PrimaryButton}" Height="42" Margin="0,22,0,0" IsDefault="True"
                        Command="{Binding LoginCommand}">
                    <Grid>
                        <TextBlock Text="Masuk" Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}"/>
                        <TextBlock Text="Memeriksa..." Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Button>

                <Border Margin="0,24,0,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="{Binding DemoHint}" Style="{StaticResource Muted}" FontSize="11.5"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
