<UserControl x:Class="SITA.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SITA.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:DashboardViewModel}">

    <UserControl.Resources>
        <!-- Stat card: Tag = accent brush, content laid out by the caller -->
        <Style x:Key="StatIcon" TargetType="Border">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <!-- Activity icon colored by action -->
        <Style x:Key="ActivityIcon" TargetType="Border">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Background" Value="{DynamicResource NeutralSoftBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource NeutralBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Aksi}" Value="Tambah">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Aksi}" Value="Ubah">
                    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Aksi}" Value="Hapus">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Aksi}" Value="Login">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ActivityGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Text" Value="&#xE946;"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Aksi}" Value="Tambah"><Setter Property="Text" Value="&#xE710;"/></DataTrigger>
                <DataTrigger Binding="{Binding Aksi}" Value="Ubah"><Setter Property="Text" Value="&#xE70F;"/></DataTrigger>
                <DataTrigger Binding="{Binding Aksi}" Value="Hapus"><Setter Property="Text" Value="&#xE74D;"/></DataTrigger>
                <DataTrigger Binding="{Binding Aksi}" Value="Login"><Setter Property="Text" Value="&#xE77B;"/></DataTrigger>
                <DataTrigger Binding="{Binding Aksi}" Value="Logout"><Setter Property="Text" Value="&#xE7E8;"/></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- ===== Stat cards ===== -->
            <UniformGrid Columns="4" Margin="-8,0">
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <DockPanel>
                            <Border Style="{StaticResource StatIcon}" Background="{DynamicResource AccentSoftBrush}" DockPanel.Dock="Right">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7BE;" FontSize="19" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock Text="Mahasiswa TA Aktif" Style="{StaticResource StatLabel}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Summary.MahasiswaTaAktif}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="{Binding TaCaption}" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <DockPanel>
                            <Border Style="{StaticResource StatIcon}" Background="{DynamicResource InfoSoftBrush}" DockPanel.Dock="Right">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8BD;" FontSize="19" Foreground="{DynamicResource InfoBrush}"/>
                            </Border>
                            <TextBlock Text="Bimbingan Bulan Ini" Style="{StaticResource StatLabel}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Summary.BimbinganBulanIni}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="{Binding BimbinganTrend}" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <DockPanel>
                            <Border Style="{StaticResource StatIcon}" Background="{DynamicResource WarningSoftBrush}" DockPanel.Dock="Right">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="19" Foreground="{DynamicResource WarningBrush}"/>
                            </Border>
                            <TextBlock Text="Sidang 30 Hari ke Depan" Style="{StaticResource StatLabel}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Summary.SidangMendatang}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="seminar &amp; sidang terjadwal" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8,0">
                    <StackPanel>
                        <DockPanel>
                            <Border Style="{StaticResource StatIcon}" Background="{DynamicResource SuccessSoftBrush}" DockPanel.Dock="Right">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" FontSize="19" Foreground="{DynamicResource SuccessBrush}"/>
                            </Border>
                            <TextBlock Text="Mahasiswa Lulus" Style="{StaticResource StatLabel}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Summary.Lulus}" Style="{StaticResource StatValue}"/>
                        <TextBlock Text="{Binding LulusCaption}" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ===== Charts row ===== -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Bimbingan per bulan (vertical bars) -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Aktivitas Bimbingan" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Jumlah sesi bimbingan per bulan, 6 bulan terakhir" Style="{StaticResource Muted}" Margin="0,2,0,16"/>
                        <ItemsControl ItemsSource="{Binding BulanBars}" Height="210">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="{Binding Empty}"/>
                                            <RowDefinition Height="{Binding Filled}"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Spans the fixed headroom row so the tallest bar's label is never clipped -->
                                        <TextBlock Grid.RowSpan="2" Text="{Binding Value}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                   FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" Foreground="{DynamicResource TextBrush}"/>
                                        <Border Grid.Row="2" CornerRadius="6,6,2,2" MaxWidth="46" MinHeight="3">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#818CF8" Offset="0"/>
                                                    <GradientStop Color="#4F46E5" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Grid.Row="3" Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                                   Style="{StaticResource Muted}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Sebaran tahap (horizontal bars) -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sebaran Tahap TA" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Jumlah mahasiswa di setiap tahap" Style="{StaticResource Muted}" Margin="0,2,0,14"/>
                        <ItemsControl ItemsSource="{Binding TahapBars}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Height="10" CornerRadius="5" Background="{DynamicResource SurfaceAltBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Filled}"/>
                                                    <ColumnDefinition Width="{Binding Empty}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="5" Background="{DynamicResource AccentBrush}"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                   FontSize="12.5" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Lists row ===== -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Upcoming sidang -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sidang Terdekat" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <TextBlock Text="Tidak ada sidang terjadwal." Style="{StaticResource Muted}" Margin="0,8"
                                   Visibility="{Binding UpcomingSidang.Count, Converter={StaticResource ZeroToVis}}"/>
                        <ItemsControl ItemsSource="{Binding UpcomingSidang}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48" Height="50" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Waktu, StringFormat='{}{0:dd}'}" FontSize="17" FontWeight="Bold"
                                                           HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding Waktu, StringFormat='{}{0:MMM}'}" FontSize="10.5"
                                                           HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NamaMahasiswa}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding JenisLabel, Mode=OneWay}"/> • <Run Text="{Binding Waktu, StringFormat='{}{0:HH:mm}', Mode=OneWay}"/> • <Run Text="{Binding Ruang, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Workload per dosen (admin) / spacer for dosen -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Beban Bimbingan Dosen" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Mahasiswa bimbingan aktif per dosen" Style="{StaticResource Muted}" Margin="0,2,0,10"/>
                        <ItemsControl ItemsSource="{Binding BebanBars}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,5">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" FontSize="12.5"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <Border Height="6" CornerRadius="3" Margin="0,5,0,0" Background="{DynamicResource SurfaceAltBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Filled}"/>
                                                    <ColumnDefinition Width="{Binding Empty}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="3" Background="{DynamicResource InfoBrush}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Recent activity (widens into the workload slot for lecturers) -->
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <!-- Set here, not locally, so the trigger below can override it -->
                            <Setter Property="Grid.Column" Value="4"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                                    <Setter Property="Grid.Column" Value="2"/>
                                    <Setter Property="Grid.ColumnSpan" Value="3"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Aktivitas Terbaru" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Activities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource ActivityIcon}" VerticalAlignment="Top">
                                            <TextBlock Style="{StaticResource ActivityGlyph}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Deskripsi}" FontSize="12.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0">
                                                <Run Text="{Binding Username, Mode=OneWay}"/> • <Run Text="{Binding CreatedAt, Converter={StaticResource RelativeTime}, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
