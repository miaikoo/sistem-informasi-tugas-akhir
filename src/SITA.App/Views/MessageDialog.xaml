<Window x:Class="SITA.App.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            CornerRadius="14" Margin="16" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.25"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBg" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource DangerSoftBrush}">
                    <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{DynamicResource DangerBrush}"/>
                </Border>
                <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" FontSize="16" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" Margin="0,16,0,0" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Batal" Margin="0,0,10,0"
                        IsCancel="True" Click="OnCancel"/>
                <Button x:Name="ConfirmButton" Style="{StaticResource DangerButton}" IsDefault="True" Click="OnConfirm"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
