<UserControl x:Class="SITA.App.Views.TugasAkhirView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SITA.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:TugasAkhirViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <DockPanel Margin="20,16">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"
                            Visibility="{Binding CanCreate, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="Daftarkan TA"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource SearchBox}" Width="250" Tag="Cari NIM, nama, atau judul..."
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Width="160" Margin="10,0,0,0" ItemsSource="{Binding TahapFilterOptions}"
                                  DisplayMemberPath="Label" SelectedItem="{Binding TahapFilter}"/>
                        <ComboBox Width="200" Margin="10,0,0,0" ItemsSource="{Binding PembimbingFilterOptions}"
                                  DisplayMemberPath="Label" SelectedItem="{Binding PembimbingFilter}"
                                  Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} data'}" Style="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </DockPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" RowHeight="58">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding EditCommand}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="MAHASISWA" Width="1.3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NamaMahasiswa}" FontWeight="SemiBold" Style="{StaticResource CellText}"/>
                                        <TextBlock Text="{Binding Nim}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="JUDUL" Width="2.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Judul}" Style="{StaticResource CellText}" ToolTip="{Binding Judul}"/>
                                        <TextBlock Text="{Binding BidangMinat}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PEMBIMBING" Binding="{Binding PembimbingDisplay}" Width="1.6*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                    <Setter Property="ToolTip" Value="{Binding PembimbingDisplay}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="TAHAP" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Style="{StaticResource Badge}" Tag="{Binding Tahap}" Content="{Binding TahapLabel}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="BIMBINGAN" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding JumlahBimbingan, StringFormat='{}{0}× sesi'}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding BimbinganTerakhir, StringFormat='{}terakhir {0:dd MMM}', TargetNullValue='belum ada'}"
                                                   Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Ubah" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        <Button Style="{StaticResource IconButtonDanger}" Content="&#xE74D;" ToolTip="Hapus" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Visibility="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BE;" FontSize="36" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="Tidak ada tugas akhir yang cocok." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.ColumnSpan="2" Style="{StaticResource FormPanel}" Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="22,18,14,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding CancelFormCommand}"/>
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource SectionTitle}" FontSize="16" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0">
                    <StackPanel Margin="0,0,0,12">
                        <Border Style="{StaticResource FormError}" Visibility="{Binding FormError, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding FormError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" LineHeight="20"/>
                        </Border>
                        <TextBlock Text="Mahasiswa *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding MahasiswaOptions}" DisplayMemberPath="Display" SelectedValuePath="Id"
                                  SelectedValue="{Binding Editor.MahasiswaId}" IsEnabled="{Binding IsNew}"/>
                        <TextBlock Text="Judul Tugas Akhir *" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource MultiLineTextBox}" Text="{Binding Editor.Judul, UpdateSourceTrigger=PropertyChanged}" MaxLength="250"/>
                        <TextBlock Text="Bidang Minat" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Editor.BidangMinat, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>
                        <TextBlock Text="Tahap *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding TahapOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Editor.Tahap}"/>

                        <TextBlock Text="Pembimbing 1 *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding DosenList}" DisplayMemberPath="Nama" SelectedValuePath="Id"
                                  SelectedValue="{Binding Editor.Pembimbing1Id}" IsEnabled="{Binding IsAdmin}"/>
                        <TextBlock Text="Pembimbing 2" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Pembimbing2Options}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Pembimbing2Selection}" IsEnabled="{Binding IsAdmin}"/>
                        <TextBlock Text="Tanggal Mulai *" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding Editor.TanggalMulai}" IsEnabled="{Binding IsAdmin}"/>

                        <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="8" Background="{DynamicResource InfoSoftBrush}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Style="{StaticResource Muted}" Foreground="{DynamicResource InfoBrush}"
                                       Text="Sebagai dosen, Anda dapat memperbarui judul, bidang minat, dan tahap. Pembimbing diatur oleh admin prodi."/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="Batal" Margin="0,0,10,0" Command="{Binding CancelFormCommand}"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Simpan" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
