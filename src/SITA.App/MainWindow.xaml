<Window x:Class="SITA.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SITA.App.ViewModels"
        xmlns:views="clr-namespace:SITA.App.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="SITA – Sistem Informasi Tugas Akhir" Width="1360" Height="840" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MahasiswaViewModel}"><views:MahasiswaView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DosenViewModel}"><views:DosenView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProdiViewModel}"><views:ProdiView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TugasAkhirViewModel}"><views:TugasAkhirView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BimbinganViewModel}"><views:BimbinganView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SidangViewModel}"><views:SidangView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PenggunaViewModel}"><views:PenggunaView/></DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshPageCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- ========== Sidebar ========== -->
        <Border Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="24,26,24,18">
                    <Border Width="40" Height="40" CornerRadius="11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#8B5CF6" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7BE;" FontSize="19" Foreground="White"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SITA" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource SidebarTextBrush}"/>
                        <TextBlock Text="Sistem Informasi Tugas Akhir" FontSize="10.5" Foreground="{DynamicResource SidebarMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="15" Width="20"/>
                                <TextBlock Text="{Binding Title}" FontSize="13.5" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Signed-in user -->
                <Border Grid.Row="2" Margin="12,8,12,16" Padding="12" CornerRadius="12" Background="{DynamicResource SidebarActiveBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" Foreground="{DynamicResource SidebarTextBrush}" FontWeight="SemiBold"
                                       FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding UserRole}" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE7E8;" ToolTip="Keluar"
                                Foreground="{DynamicResource SidebarMutedBrush}" Command="{Binding LogoutCommand}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ========== Content ========== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="32,26,32,18">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="12,0" Height="38" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE787;" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Source={x:Static sys:DateTime.Today}, StringFormat='{}{0:dddd, d MMMM yyyy}'}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SecondaryButton}" Width="38" Padding="0" Margin="0,0,10,0"
                            ToolTip="Muat ulang (F5)" Command="{Binding RefreshPageCommand}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Padding="12,0" Command="{Binding ToggleThemeCommand}" ToolTip="Ganti tema">
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="14"
                                           Visibility="{Binding IsDark, Converter={StaticResource InverseBoolToVis}}"/>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="14"
                                           Visibility="{Binding IsDark, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                            <Grid Margin="8,0,0,0">
                                <TextBlock Text="Mode Gelap" Visibility="{Binding IsDark, Converter={StaticResource InverseBoolToVis}}"/>
                                <TextBlock Text="Mode Terang" Visibility="{Binding IsDark, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="32,0,32,28" Focusable="False"/>

            <!-- Toast -->
            <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
                    Background="{DynamicResource TextBrush}" CornerRadius="10" Padding="16,11"
                    Visibility="{Binding Notifications.IsVisible, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" Foreground="{DynamicResource SuccessSoftBrush}"/>
                    <TextBlock Text="{Binding Notifications.Message}" Margin="10,0,0,0" Foreground="{DynamicResource BgBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
